{
  "description": "Route DSL tables: which calls and extractors build path segments, and which name the HTTP verbs.",
  "verbs": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS"],
  "tapir": {
    "segmentOwners": ["sttp.tapir.Tapir"],
    "literalNames": ["stringToPath"],
    "captureNames": ["path", "paths"],
    "verbOwnerPrefix": "sttp.tapir.EndpointInputsOps."
  },
  "http4s": {
    "segmentOwner": "org.http4s.dsl.impl./$",
    "captureOwner": "org.http4s.dsl.impl.PathVar",
    "verbPrefix": "org.http4s.dsl.impl.Methods.",
    "routerOwner": "org.http4s.server.Router$"
  },
  "pekko": {
    "ownerPrefixes": [
      "org.apache.pekko.http.scaladsl.server.",
      "akka.http.scaladsl.server."
    ],
    "pathNames": ["path", "pathPrefix", "pathSuffix", "pathEnd", "pathEndOrSingleSlash", "pathSingleSlash"],
    "prefixNames": ["pathPrefix", "pathPrefixes"],
    "verbs": {
      "get": "GET",
      "post": "POST",
      "put": "PUT",
      "delete": "DELETE",
      "patch": "PATCH",
      "head": "HEAD",
      "options": "OPTIONS"
    },
    "matchers": ["Segment", "Segments", "IntNumber", "LongNumber", "JavaUUID", "Remaining", "RemainingPath", "Neutral"],
    "composer": "~"
  },
  "zio": {
    "segmentOwners": ["zio.http.codec.PathCodec$"],
    "captureOwners": ["zio.http.package$", "zio.http.codec.PathCodec$"],
    "captureNames": ["int", "string", "long", "boolean", "uuid", "literal"],
    "routeOwner": "zio.http.RoutePattern",
    "routeNames": ["->"],
    "verbPrefix": "zio.http.Method."
  },
  "cask": {
    "annotationPrefixes": ["cask.endpoints.", "cask."],
    "verbs": {
      "get": "GET",
      "post": "POST",
      "put": "PUT",
      "delete": "DELETE",
      "patch": "PATCH",
      "route": "GET",
      "getJson": "GET",
      "postJson": "POST",
      "webSocketUpgraded": "GET"
    }
  },
  "scalatra": {
    "ownerPrefixes": ["org.scalatra.", "com.github.tototoshi."],
    "verbs": {
      "get": "GET",
      "post": "POST",
      "put": "PUT",
      "delete": "DELETE",
      "patch": "PATCH",
      "options": "OPTIONS",
      "head": "HEAD"
    }
  },
  "play": {
    "framework": "play",
    "generatedPaths": ["target/", "out/"]
  }
}
