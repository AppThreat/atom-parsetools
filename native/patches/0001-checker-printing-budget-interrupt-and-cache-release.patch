+++ b/tsc/internal/checker/atom_budget.go
@@ -0,0 +1,57 @@
+package checker
+
+import "sync/atomic"
+
+// Atom parsetools additions. Everything here is opt-in: a checker that never calls
+// SetInterrupt, and a VerbosityContext with MaxBuilderCalls == 0, behave as before.
+
+// Interrupted is the panic value used when a checker's interrupt flag is set or its work limit is
+// exceeded. It unwinds the query in progress. State the interrupted query had half built may be
+// inconsistent (a signature marked as being resolved stays marked), so a checker that was
+// interrupted must be discarded.
+type Interrupted struct {
+	WorkLimit bool // true when the work limit was exceeded, false when the flag was set
+}
+
+func (e Interrupted) Error() string {
+	if e.WorkLimit {
+		return "checker work limit exceeded"
+	}
+	return "checker interrupted"
+}
+
+// BuilderBudgetExceeded is the panic value used when printing one type takes more node builder
+// calls than VerbosityContext.MaxBuilderCalls allows.
+type BuilderBudgetExceeded struct{ Calls int }
+
+func (e BuilderBudgetExceeded) Error() string { return "type printing exceeded its node builder budget" }
+
+// SetInterrupt makes the checker poll flag in its hot paths (flow analysis and expression
+// checking). Setting the flag from another goroutine makes the running query panic with Interrupted.
+func (c *Checker) SetInterrupt(flag *atomic.Bool) { c.interrupt = flag }
+
+// SetWorkLimit resets the work counter and makes the checker panic with Interrupted{WorkLimit: true}
+// once it has polled more than limit times (one poll per expression checked, flow node visited and
+// type node built). The count depends only on the code and the checker's earlier state, not on
+// timing, so a limit stops a runaway query at the same point on every run. 0 removes the limit.
+func (c *Checker) SetWorkLimit(limit int64) {
+	c.work = 0
+	c.workLimit = limit
+}
+
+// Work returns the number of polls since SetWorkLimit.
+func (c *Checker) Work() int64 { return c.work }
+
+func (c *Checker) pollInterrupt() {
+	c.work++
+	if c.workLimit > 0 && c.work > c.workLimit {
+		panic(Interrupted{WorkLimit: true})
+	}
+	if c.interrupt != nil && c.interrupt.Load() {
+		panic(Interrupted{})
+	}
+}
+
+// ReleasePrinterCaches drops the node builder used for printing types, together with the
+// serialized type nodes it cached for every enclosing declaration it printed at.
+func (c *Checker) ReleasePrinterCaches() { c.typeToStringNodebuilder = nil }
